# Test: List comprehensions support bracket literals, range iteration, and filtering
# Expected: Pass

set numbers to [1, 2, 3, 4, 5, 6]
set squares to [value times value for value in range 1 to 6]
set evens to [value for value in numbers if value mod 2 is equal 0]

print call len with squares
print squares at 2
print call len with evens
print evens at 1
